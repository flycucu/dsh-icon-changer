# Normalize line endings: LF in the repository, native in the working tree.
# The plugin's PowerShell scripts are deliberately ASCII-only and BOM-less (Windows
# PowerShell 5.1 parses a BOM-less non-ASCII script as ANSI and mangles it), so no
# eol/encoding overrides are needed beyond keeping binaries untouched.
* text=auto

*.ps1   text
*.js    text
*.mjs   text
*.json  text
*.yml   text
*.md    text
*.txt   text

*.ico   binary
*.exe   binary
*.png   binary
